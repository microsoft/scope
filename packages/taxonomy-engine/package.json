{
  "name": "taxonomy-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./copilot": { "source": "./src/copilot.ts", "types": "./dist/copilot.d.ts", "import": "./dist/copilot.js" },
    "./optimization-v2": { "source": "./src/optimization-v2.ts", "types": "./dist/optimization-v2.d.ts", "import": "./dist/optimization-v2.js" },
    "./evaluation-inputs": { "source": "./src/evaluation-inputs.ts", "types": "./dist/evaluation-inputs.d.ts", "import": "./dist/evaluation-inputs.js" },
    "./prompt": { "source": "./src/prompt.ts", "types": "./dist/prompt.d.ts", "import": "./dist/prompt.js" },
    "./plugins": { "source": "./src/plugins.ts", "types": "./dist/plugins.d.ts", "import": "./dist/plugins.js" }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --reporter=default"
  },
  "dependencies": {
    "@ax-llm/ax": "25.3.2",
    "@github/copilot-sdk": "1.0.1",
    "shared": "workspace:*",
    "tar-stream": "3.1.7",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^5.6.2",
    "vitest": "^4.1.0"
  }
}
