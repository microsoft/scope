# Dependencies (installed inside container)
node_modules
**/node_modules

# Build outputs
dist
**/dist
coverage
**/coverage
ctrf
**/ctrf
**/target

# Git
.git
.gitignore

# Worktrees
.worktrees

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment files (secrets — not needed in build context)
.env
.env.*
!.env.example

# Local development TLS material is mounted at runtime, never built into images.
.certs

# Documentation (not needed in images)
docs

# Deployment manifests (not part of app images)
deploy
infra

# Scripts (except dev-entrypoint.sh which is COPY'd explicitly)
# scripts/ is kept since dev-entrypoint.sh lives there

# Misc
tmp
*.md
!README.md
LICENSE
