{
  "name": "Scope development (DinD + native/Kind)",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "version": "29.3.0",
      "moby": false,
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": false
    }
  },
  "containerEnv": {
    "COMPOSE_PARALLEL_LIMIT": "2",
    "SCOPE_DIND_SPIKE": "1",
    "SCOPE_DEV_DATA": "/home/node/.scope-state",
    "CARGO_HOME": "/home/node/.cargo",
    "RUSTUP_HOME": "/opt/rustup"
  },
  "mounts": [
    "source=scope-pnpm-${devcontainerId},target=/home/node/.local/share/pnpm/store,type=volume",
    "source=scope-cargo-${devcontainerId},target=/home/node/.cargo,type=volume",
    "source=scope-data-${devcontainerId},target=/home/node/.scope-state,type=volume"
  ],
  "postCreateCommand": "sudo -n chown node:node /home/node/.local/share/pnpm/store /home/node/.cargo /home/node/.scope-state && pnpm install --frozen-lockfile && pnpm exec tsx scripts/dev/control.ts create",
  "postStartCommand": "pnpm exec tsx scripts/dev/control.ts start",
  "postAttachCommand": "pnpm exec tsx scripts/dev/control.ts attach",
  "portsAttributes": {
    "8080": { "label": "dev-edge (Codespaces HTTP transport)", "protocol": "http", "requireLocalPort": true, "onAutoForward": "notify" },
    "8443": { "label": "dev-edge (local HTTPS)", "protocol": "https", "requireLocalPort": true, "onAutoForward": "ignore" },
    "18443": { "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "settings": { "remote.autoForwardPorts": false },
      "extensions": ["vadimcn.vscode-lldb", "rust-lang.rust-analyzer", "ms-python.python", "ms-python.debugpy"]
    }
  }
}