# Scope REST API base URL (no trailing slash).
SCOPE_API_URL=http://localhost:3100
SCOPE_PROJECT_ID=

# Leave empty to create one canonical Experiment for this optimization. Set an
# existing empty/current Experiment id to append evaluation revisions there.
SCOPE_EXPERIMENT_ID=
SCOPE_EXPERIMENT_NAME=

# Scope worker + model used to evaluate each AGENTS.md candidate.
SCOPE_WORKER=coder-acp-copilot
SCOPE_MODEL=claude-haiku-4.5

# Max number of Scope runs kept in-flight at once. Defaults to 10 to match the
# Linux coder-acp-copilot KEDA ceiling (maxReplicaCount: 10).
SCOPE_MAX_CONCURRENCY=10

# Per-run polling: how long to wait for a run to reach status=done, and how
# often to poll (seconds).
SCOPE_RUN_TIMEOUT_SECONDS=1800
SCOPE_POLL_INTERVAL_SECONDS=15

# Multi-turn iterations per Scope run.
SCOPE_MAX_ITERATIONS=10

# Scoring strategy over a run's turns: mean | final | weighted.
SCOPE_SCORE_STRATEGY=mean

# GEPA budget. Each metric call is ONE full (slow) Scope agent run, so keep
# this small. See README for budgeting math.
GEPA_MAX_METRIC_CALLS=12
GEPA_REFLECTION_MINIBATCH_SIZE=2

# Reflection LM passed to gepa.optimize (litellm model string). The reflection
# LM rewrites the AGENTS.md; it is NOT the agent under test.
GEPA_REFLECTION_LM=azure/gpt-5.5

# Azure OpenAI credentials for the reflection LM (litellm reads these).
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-12-01-preview
