  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^10.0.0",
    "llm-eval": "workspace:*",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
