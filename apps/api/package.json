{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "generate:openapi": "pnpm --dir ../.. --filter shared --filter db-migrations build && tsx src/openapi/generate.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@azure-rest/ai-inference": "^1.0.0-beta.6",
    "@azure/core-auth": "^1.9.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/storage-blob": "^12.26.0",
    "@azure/storage-queue": "^12.24.0",
    "cors": "^2.8.5",
    "db-migrations": "workspace:*",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "multer": "^2.3.0",
    "openapi3-ts": "^4.5.0",
    "shared": "workspace:*",
    "telemetry": "workspace:*",
    "swagger-ui-express": "^5.0.1",
    "tar-stream": "^3.1.7",
    "uuid": "^11.1.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
