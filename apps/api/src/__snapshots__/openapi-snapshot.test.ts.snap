                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RequestResponse",
                    },
                    {
                      "items": {
                        "$ref": "#/components/schemas/RequestResponse",
                      },
                      "type": "array",
                    },
                  ],
                },
              },
            },
            "description": "Success",
