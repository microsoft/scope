                              "outcome": {
                                "enum": [
                                  "succeeded",
                                  "invalid_output",
                                  "execution_failed",
                                  "cancelled",
                                ],
                                "type": "string",
                              },
                            },
                            "required": [
                              "attempt",
                              "kind",
                              "outcome",
                            ],
                            "type": "object",
                          },
                          "maxItems": 2,
                          "minItems": 1,
                          "type": "array",
                        },
                        "handler": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "provider": {
                          "additionalProperties": false,
                          "properties": {
                            "entry": {
                              "minLength": 1,
                              "type": "string",
                            },
                            "integrity": {
                              "pattern": "^[a-f0-9]{64}$",
                              "type": "string",
                            },
                            "name": {
                              "minLength": 1,
                              "type": "string",
                            },
                            "origin": {
                              "enum": [
                                "builtin",
                                "local",
                                "package",
                              ],
                              "type": "string",
                            },
                            "version": {
                              "minLength": 1,
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                            "origin",
                          ],
                          "type": "object",
                        },
                        "type": {
                          "enum": [
                            "prompt",
                            "deterministic",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "attempts",
                      ],
                      "type": "object",
                    },
                    "input": {
                      "additionalProperties": false,
                      "properties": {
                        "archive_root": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "normalization": {
                          "enum": [
                            "scope/taxonome-normalized-atif/v1",
                          ],
                          "type": "string",
                        },
                        "request_id": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "run_id": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "session_id": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "sha256": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "trajectory_id": {
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "normalization",
                        "sha256",
                      ],
                      "type": "object",
                    },
                    "schema_version": {
                      "enum": [
                        "scope/taxonomy-evaluation/v1",
                      ],
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "failed",
                      ],
                      "type": "string",
                    },
                    "taxonomy": {
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "id": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "version": {
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "version",
                        "digest",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "schema_version",
                    "taxonomy",
                    "element",
                    "implementation",
                    "input",
                    "status",
                    "error",
                  ],
                  "type": "object",
                },
              ],
            },
            "type": "array",
          },
          "run": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string",
              },
              "profile": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "label": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "label",
                ],
                "type": "object",
              },
              "scenario": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "label": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "task": {
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "label",
                ],
                "type": "object",
              },
            },
            "required": [
              "id",
              "scenario",
              "profile",
            ],
            "type": "object",
          },
        },
        "required": [
          "run",
          "results",
        ],
        "type": "object",
      },
      "TokenUsage": {
        "properties": {
          "completionTokens": {
            "type": "number",
          },
          "promptTokens": {
            "type": "number",
          },
          "totalTokens": {
            "type": "number",
          },
        },
        "required": [
          "promptTokens",
          "completionTokens",
          "totalTokens",
        ],
        "type": "object",
      },
      "TriggerReportsInput": {
        "properties": {
          "requestId": {
            "type": "string",
          },
        },
        "required": [
          "requestId",
        ],
        "type": "object",
      },
      "UpdateAgentInput": {
        "properties": {
          "available": {
            "type": "boolean",
          },
          "capabilities": {
            "$ref": "#/components/schemas/AgentCapabilities",
          },
          "defaultModel": {
            "type": "string",
          },
          "description": {
            "type": "string",
          },
          "modelProvider": {
            "type": "string",
          },
          "name": {
            "type": "string",
          },
          "supportedModels": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "type": "object",
      },
      "UpdateCodebaseInput": {
        "properties": {
          "defaultBranch": {
            "type": "string",
          },
          "description": {
            "type": "string",
          },
          "name": {
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateCriteriaInput": {
        "properties": {
          "dependsOn": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "gates": {
            "items": {
              "enum": [
                "select",
                "build",
                "test",
                "run",
                "deploy",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "kind": {
            "enum": [
              "gate",
              "observation",
            ],
            "type": "string",
          },
          "prompt": {
            "type": "string",
          },
          "subject": {
            "enum": [
              "run",
              "iteration",
            ],
            "type": "string",
          },
          "taxonomyElementId": {
            "enum": [
              "dimension:idiomatic-use",
              "dimension:dependency-currency",
              "dimension:configuration-correctness",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateExtensionInput": {
        "properties": {
          "description": {
            "type": "string",
          },
          "name": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateFeatureFlagInput": {
        "properties": {
          "enabled": {
            "type": "boolean",
          },
        },
        "required": [
          "enabled",
        ],
        "type": "object",
      },
      "UpdateInsightInput": {
        "properties": {
          "category": {
            "type": "string",
          },
          "description": {
            "type": "string",
          },
          "tags": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "title": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateMcpServerInput": {
        "properties": {
          "args": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "command": {
            "type": "string",
          },
          "description": {
            "type": "string",
          },
          "env": {
            "additionalProperties": {
              "type": "string",
            },
            "type": "object",
          },
          "headers": {
            "items": {
              "$ref": "#/components/schemas/McpServerHeader",
            },
            "type": "array",
          },
          "name": {
            "type": "string",
          },
          "sessionMode": {
            "enum": [
              "stateful",
              "stateless",
            ],
            "type": "string",
          },
          "type": {
            "enum": [
              "sse",
              "http",
              "stdio",
            ],
            "type": "string",
          },
          "url": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateProfileIdentity": {
        "properties": {
          "description": {
            "maxLength": 512,
            "type": "string",
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateProjectInput": {
        "properties": {
          "description": {
            "type": "string",
          },
          "name": {
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdatePromptFeatureInput": {
        "properties": {
          "prompt": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateReportTemplateInput": {
        "properties": {
          "description": {
            "type": "string",
          },
          "enabled": {
            "type": "boolean",
          },
          "model": {
            "type": [
              "string",
              "null",
            ],
          },
          "name": {
            "type": "string",
          },
          "systemPrompt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateSystemPrompt",
              },
              {
                "type": [
                  "object",
                  "null",
                ],
              },
            ],
          },
          "timeoutMs": {
            "exclusiveMinimum": 0,
            "type": [
              "integer",
              "null",
            ],
          },
          "trigger": {
            "$ref": "#/components/schemas/ReportTrigger",
          },
          "userPrompt": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateResourceInput": {
        "properties": {
          "description": {
            "type": "string",
          },
          "name": {
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateTaxonomyMetadataInput": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 4096,
            "type": "string",
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UserMeResponse": {
        "properties": {
          "displayName": {
            "type": "string",
          },
          "email": {
            "type": "string",
          },
          "id": {
            "type": "string",
          },
          "idp": {
            "type": "string",
          },
          "idpTenant": {
            "type": "string",
          },
          "role": {
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "ValidateKeyInput": {
        "properties": {
          "token": {
            "type": "string",
          },
        },
        "required": [
          "token",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Use the unchanged IdP access token, without the Bearer prefix.",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "description": "REST API for the Scope platform — benchmarking AI coding agents",
    "title": "Scope API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/about": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "buildTime": {
                      "type": "string",
                    },
                    "description": {
                      "type": "string",
                    },
                    "environment": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                    "workers": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "name",
                    "version",
                    "buildTime",
                    "environment",
                    "description",
                    "workers",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "API metadata",
        "tags": [
          "System",
        ],
      },
    },
    "/api/v1/accounts": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List accounts",
        "tags": [
          "Accounts",
        ],
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse",
                },
              },
            },
            "description": "Account created",
          },
        },
        "summary": "Create account",
        "tags": [
          "Accounts",
        ],
      },
    },
    "/api/v1/accounts/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "success",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Account deleted",
          },
        },
        "summary": "Delete account",
        "tags": [
          "Accounts",
        ],
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "Get account",
        "tags": [
          "Accounts",
        ],
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse",
                },
              },
            },
            "description": "Account updated",
          },
        },
        "summary": "Update account",
        "tags": [
          "Accounts",
        ],
      },
    },
    "/api/v1/agents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "modelProvider",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeDeleted",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List agents",
        "tags": [
          "Agents",
        ],
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentInput",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Validation error",
          },
          "409": {
            "description": "Restored agent versions conflict with an active queue owner",
          },
        },
        "summary": "Create or update agent (upsert)",
        "tags": [
          "Agents",
        ],
      },
    },
    "/api/v1/agents/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "Delete agent",
        "tags": [
          "Agents",
        ],
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeDeleted",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse",
                },
              },
            },
            "description": "Success",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "Get agent",
        "tags": [
          "Agents",
        ],
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAgentInput",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Validation error",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "Update agent",
        "tags": [
          "Agents",
        ],
      },
    },
    "/api/v1/agents/{id}/versions": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentVersion",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "List agent versions",
        "tags": [
          "Agents",
        ],
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAgentVersionInput",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentVersion",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Validation error",
          },
          "404": {
            "description": "Agent not found",
          },
          "409": {
            "description": "Queue is assigned to another agent",
          },
          "503": {
            "description": "Concurrent registration did not stabilize",
          },
        },
        "summary": "Register agent version (upsert)",
        "tags": [
          "Agents",
        ],
      },
    },
    "/api/v1/agents/{id}/versions/{agentVersion}": {
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "agentVersion",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchAgentVersionInput",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentVersion",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Invalid status value",
          },
          "404": {
            "description": "Agent or version not found",
          },
          "409": {
            "description": "Queue is assigned to another agent",
          },
          "503": {
            "description": "Concurrent activation did not stabilize",
          },
        },
        "summary": "Patch agent version",
        "tags": [
          "Agents",
        ],
      },
    },
    "/api/v1/analysis": {
      "get": {
        "description": "Aggregates pass@k / success@T metrics over a single project's done runs. Requires ?projectId=.",
        "parameters": [
          {
