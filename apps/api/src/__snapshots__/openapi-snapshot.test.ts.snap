      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse",
                },
              },
            },
            "description": "Account updated",
          },
        },
        "summary": "Update account",
        "tags": [
          "Accounts",
        ],
      },
    },
    "/api/v1/agents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "modelProvider",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeDeleted",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List agents",
        "tags": [
          "Agents",
        ],
