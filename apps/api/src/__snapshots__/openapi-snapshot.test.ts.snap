            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "description": "Optional project scope. When provided, a slug/id is resolved within that project (slugs may repeat across projects); when omitted, resolution falls back to a legacy global lookup for backward compatibility.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "model": {
                    "type": "string",
                  },
                  "text": {
                    "type": "string",
                  },
                  "type": {
                    "enum": [
                      "select",
                      "agents.md",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "text",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cached": {
                      "type": "boolean",
                    },
                    "features": {
                      "items": {
                        "$ref": "#/components/schemas/PromptFeatureResult",
                      },
                      "type": "array",
                    },
                    "suggestedFeatures": {
                      "items": {
                        "$ref": "#/components/schemas/SuggestedPromptFeature",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "features",
                    "cached",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Empty text string",
          },
          "503": {
            "description": "LLM not configured",
          },
        },
        "summary": "Extract features from text",
        "tags": [
          "Prompt Features",
        ],
