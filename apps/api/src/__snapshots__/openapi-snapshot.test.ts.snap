    "/api/v1/criteria/generate-prompt": {
      "post": {
        "parameters": [
          {
            "description": "Optional project scope. When provided, a slug/id is resolved within that project (slugs may repeat across projects); when omitted, resolution falls back to a legacy global lookup for backward compatibility.",
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "description": "Optional project scope. When provided, a slug/id is resolved within that project (slugs may repeat across projects); when omitted, resolution falls back to a legacy global lookup for backward compatibility.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "behavior": {
                    "type": "string",
                  },
                  "currentId": {
                    "type": "string",
                  },
                  "gates": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "behavior",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "prompt": {
                      "type": "string",
                    },
                    "suggestedChildren": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "suggestedId": {
                      "type": "string",
                    },
                    "suggestedParents": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "prompt",
                    "suggestedId",
                    "suggestedParents",
                    "suggestedChildren",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Empty behavior string",
          },
          "503": {
            "description": "LLM not configured",
          },
        },
        "summary": "Generate criterion prompt from behavior",
        "tags": [
          "Criteria",
        ],
      },
    },
