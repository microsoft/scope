                      },
                      "type": "array",
                    },
                    "removed": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "unchanged": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "added",
                    "removed",
                    "unchanged",
                  ],
                  "type": "object",
                },
