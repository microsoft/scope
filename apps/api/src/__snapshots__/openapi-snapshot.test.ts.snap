            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeDeleted",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse",
                },
              },
            },
            "description": "Success",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "Get agent",
        "tags": [
          "Agents",
        ],
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAgentInput",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "description": "Validation error",
          },
          "404": {
            "description": "Agent not found",
          },
        },
        "summary": "Update agent",
        "tags": [
          "Agents",
        ],
      },
    },
    "/api/v1/agents/{id}/versions": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentVersion",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
          "404": {
            "description": "Agent not found",
          },
        },
