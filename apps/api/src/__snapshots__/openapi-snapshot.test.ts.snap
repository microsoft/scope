    "/api/v1/criteria": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Comma-separated criterion IDs to include",
            "in": "query",
            "name": "ids",
            "required": false,
            "schema": {
              "description": "Comma-separated criterion IDs to include",
              "type": "string",
            },
          },
          {
            "description": "When true and ids is set, also include dependency ancestors",
            "in": "query",
            "name": "ancestors",
            "required": false,
            "schema": {
              "description": "When true and ids is set, also include dependency ancestors",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CriteriaResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List criteria",
        "tags": [
          "Criteria",
        ],
      },
      "post": {
        "parameters": [
          {
            "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCriteriaInput",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CriteriaResponse",
                },
              },
            },
            "description": "Success",
          },
          "409": {
            "description": "Criterion already exists",
          },
        },
        "summary": "Create criterion",
        "tags": [
          "Criteria",
        ],
      },
    },
    "/api/v1/criteria/generate-prompt": {
      "post": {
        "parameters": [
          {
            "description": "Optional project scope. When provided, a slug/id is resolved within that project (slugs may repeat across projects); when omitted, resolution falls back to a legacy global lookup for backward compatibility.",
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "description": "Optional project scope. When provided, a slug/id is resolved within that project (slugs may repeat across projects); when omitted, resolution falls back to a legacy global lookup for backward compatibility.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "behavior": {
                    "type": "string",
                  },
                  "currentId": {
                    "type": "string",
                  },
                  "gates": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "behavior",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
