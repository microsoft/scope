                        "providerEndOfLife": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                  "provider": {
                    "type": "string",
                  },
                  "scannedAt": {
                    "type": "string",
                  },
                },
                "required": [
