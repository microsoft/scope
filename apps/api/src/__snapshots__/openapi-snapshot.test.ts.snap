        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Use the unchanged IdP access token, without the Bearer prefix.",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "description": "REST API for the Scope platform — benchmarking AI coding agents",
    "title": "Scope API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/about": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "buildTime": {
                      "type": "string",
                    },
                    "description": {
                      "type": "string",
                    },
                    "environment": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                    "workers": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "name",
                    "version",
                    "buildTime",
                    "environment",
                    "description",
                    "workers",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "API metadata",
        "tags": [
          "System",
        ],
      },
    },
    "/api/v1/accounts": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List accounts",
        "tags": [
