        ],
      },
      "post": {
        "parameters": [
          {
            "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "description": "Project scope. Required on scoped list and root-create operations; requests without a resolvable project are rejected with 400. There is no default project.",
              "example": "00000000-0000-0000-0000-000000000000",
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "201": {
            "description": "Success",
          },
          "400": {
            "description": "Invalid input or missing archive",
