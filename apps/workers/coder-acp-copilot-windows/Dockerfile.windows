ARG COPILOT_CLI_VERSION

# --- Base stage: runtime tools shared by builder and production ---
# Windows Server Core LTSC 2022 with Node.js, Git, pnpm, and Copilot CLI.
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS base

SHELL ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install Chocolatey
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; \
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
    iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

# Install Node.js via direct MSI download
ARG NODE_VERSION=22.16.0
RUN Invoke-WebRequest -Uri "https://nodejs.org/dist/v${env:NODE_VERSION}/node-v${env:NODE_VERSION}-x64.msi" \
    -OutFile C:\node.msi; \
    Start-Process msiexec.exe -ArgumentList '/i', 'C:\node.msi', '/quiet', '/norestart' -Wait; \
    Remove-Item C:\node.msi

# Install git via Chocolatey
RUN choco install -y git

# Install pnpm as a standalone executable
RUN New-Item -ItemType Directory -Force -Path C:\tools | Out-Null; \
    Invoke-WebRequest -Uri 'https://github.com/pnpm/pnpm/releases/download/v10.29.1/pnpm-win-x64.exe' \
    -OutFile 'C:\tools\pnpm.exe'

# Install GitHub Copilot CLI globally to C:\tools so it lands on PATH
ARG COPILOT_CLI_VERSION
RUN npm install -g --prefix C:\tools "@github/copilot@${env:COPILOT_CLI_VERSION}"

ENV PATH="C:\tools;C:\tools\bin;C:\Program Files\nodejs;C:\Program Files\Git\cmd;C:\ProgramData\chocolatey\bin;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Windows\system32;C:\Windows"

# --- Builder stage: compile TypeScript ---
FROM base AS builder
SHELL ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

WORKDIR C:/app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/agent-protocol/package.json ./packages/agent-protocol/
COPY packages/core/package.json ./packages/core/
COPY packages/platform/package.json ./packages/platform/
COPY packages/secrets/package.json ./packages/secrets/
COPY packages/worker-runtime/package.json ./packages/worker-runtime/
COPY apps/workers/coder-acp-copilot/package.json ./apps/workers/coder-acp-copilot/
COPY apps/workers/coder-acp-copilot-windows/package.json ./apps/workers/coder-acp-copilot-windows/

RUN C:\tools\pnpm.exe install --frozen-lockfile

COPY packages/core/tsconfig.json ./packages/core/
COPY packages/core/src ./packages/core/src/
COPY packages/secrets/tsconfig.json ./packages/secrets/
COPY packages/secrets/src ./packages/secrets/src/
COPY packages/platform/tsconfig.json ./packages/platform/
COPY packages/platform/src ./packages/platform/src/
COPY packages/agent-protocol/tsconfig.json ./packages/agent-protocol/
COPY packages/agent-protocol/src ./packages/agent-protocol/src/
COPY packages/worker-runtime/tsconfig.json ./packages/worker-runtime/
COPY packages/worker-runtime/src ./packages/worker-runtime/src/
COPY apps/workers/coder-acp-copilot/tsconfig.json ./apps/workers/coder-acp-copilot/
COPY apps/workers/coder-acp-copilot/src ./apps/workers/coder-acp-copilot/src/
COPY apps/workers/coder-acp-copilot-windows/tsconfig.json ./apps/workers/coder-acp-copilot-windows/
COPY apps/workers/coder-acp-copilot-windows/src ./apps/workers/coder-acp-copilot-windows/src/

RUN C:\tools\pnpm.exe --filter core build; C:\tools\pnpm.exe --filter secrets build; C:\tools\pnpm.exe --filter platform build; C:\tools\pnpm.exe --filter agent-protocol build; C:\tools\pnpm.exe --filter worker-runtime build; C:\tools\pnpm.exe --filter coder-acp-copilot build; C:\tools\pnpm.exe --filter coder-acp-copilot-windows build

# --- Production stage ---
FROM base AS production
SHELL ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

WORKDIR C:/app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/agent-protocol/package.json ./packages/agent-protocol/
COPY packages/core/package.json ./packages/core/
COPY packages/platform/package.json ./packages/platform/
COPY packages/secrets/package.json ./packages/secrets/
COPY packages/worker-runtime/package.json ./packages/worker-runtime/
COPY apps/workers/coder-acp-copilot/package.json ./apps/workers/coder-acp-copilot/
COPY apps/workers/coder-acp-copilot-windows/package.json ./apps/workers/coder-acp-copilot-windows/

RUN C:\tools\pnpm.exe install --frozen-lockfile --prod

COPY --from=builder C:/app/packages/agent-protocol/dist ./packages/agent-protocol/dist/
COPY --from=builder C:/app/packages/core/dist ./packages/core/dist/
COPY --from=builder C:/app/packages/platform/dist ./packages/platform/dist/
COPY --from=builder C:/app/packages/secrets/dist ./packages/secrets/dist/
COPY --from=builder C:/app/packages/worker-runtime/dist ./packages/worker-runtime/dist/
COPY --from=builder C:/app/apps/workers/coder-acp-copilot/dist ./apps/workers/coder-acp-copilot/dist/
COPY --from=builder C:/app/apps/workers/coder-acp-copilot-windows/dist ./apps/workers/coder-acp-copilot-windows/dist/

# Create workspace directory for coding agents
RUN New-Item -ItemType Directory -Force -Path C:\workspace

WORKDIR C:/app/apps/workers/coder-acp-copilot-windows

# Expose component versions + build metadata at runtime (used by self-registration)
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV COPILOT_CLI_VERSION=$COPILOT_CLI_VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME
ENV WORKER_NAME=coder-acp-copilot-windows

CMD ["node", "dist/index.js"]
