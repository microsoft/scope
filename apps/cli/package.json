{
  "name": "cli",
  "version": "0.0.0-dev",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "scope": "./dist/scope.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/growth-ecosystems/scope-core.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:tsc": "tsc --noEmit",
    "pack:standalone": "pnpm build && tsx package.ts && npm pack ./dist/npm --pack-destination ./dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/scope.mjs",
    "test": "vitest run --root ../.. apps/cli/src",
    "test:integration": "vitest run --config ../../vitest.integration.config.ts"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.6.1",
    "eventsource": "^2.0.2",
    "ky": "^2.0.2",
    "semver": "^7.8.0",
    "shared": "workspace:*",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.7.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
