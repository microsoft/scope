    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cockatiel": "^3.2.1",
    "dockerode": "^4.0.9",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "tar": "^7.5.8",
    "uuid": "^11.1.1",
    "yaml": "^2.8.3",
    "yauzl": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "coder-acp-claude-code-host": "workspace:*",
    "coder-acp-copilot-host": "workspace:*",
    "docker-orchestrator": "workspace:*",
    "shared": "workspace:*",
