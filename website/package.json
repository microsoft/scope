{
  "name": "scope-doc",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "dev": "worktree-env && astro dev",
    "start": "worktree-env && astro dev",
    "build": "astro build",
    "preview": "worktree-env && astro preview",
    "test": "node --test src/plugins/*.test.mjs",
    "test:a11y": "SITE=https://microsoft.github.io BASE_PATH=/scope pnpm build && playwright test",
    "astro": "astro",
    "refresh:openapi": "cd .. && pnpm --filter api generate:openapi"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.4.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "acorn": "^8.16.0",
    "httpsnippet-lite": "^3.0.5",
    "remark-gfm": "^4.0.1",
    "starlight-openapi": "^0.25.1",
    "unist-util-visit": "^5.1.0",
    "worktree-env": "^0.1.0"
  }
}
