---
import CommunityTeaser from './community/CommunityTeaser.astro';
import ContributeTeaser from './contribute/ContributeTeaser.astro';
import FlowDemo from './FlowDemo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// CSS paints the active theme's poster, so first paint never shows the other theme's cut.
const showreelPosters = {
	'--showreel-poster-dark': `url("${base}scope-showreel-poster-dark.jpg")`,
	'--showreel-poster-light': `url("${base}scope-showreel-poster-light.jpg")`,
};
const paths = [
	{
		number: '01',
		title: 'Start in the Portal',
		description: 'Get access, submit your first task, and follow the results in your browser.',
		href: 'getting-started/first-run/',
		label: 'Your first run',
		tag: 'New to Scope',
	},
	{
		number: '02',
		title: 'Work from your terminal',
		description: 'Install the CLI and make benchmarks part of your development workflow.',
		href: 'getting-started/install-cli/',
		label: 'Set up the CLI',
		tag: 'For developers',
	},
	{
		number: '03',
		title: 'Build it into your tools',
		description: 'Explore request examples and the searchable, generated API reference.',
		href: 'reference/rest-api/',
		label: 'Explore the API',
		tag: 'For integrations',
	},
];
---

<div class="scope-home not-content">
	<section class="scope-hero" aria-labelledby="_top">
		<div class="scope-eyebrow"><span class="scope-signal" aria-hidden="true"></span> The agentic experience, measured</div>
		<h1 id="_top" tabindex="-1" data-page-title>Your product.<br />Their agents. <span>The whole picture.</span></h1>
		<p class="scope-subtitle">
			How do coding agents really handle your product? Give them the same
			task, define what good looks like, and see the evidence. That's Scope.
		</p>
		<div class="scope-actions">
			<a class="scope-btn scope-btn--primary" href={`${base}getting-started/access/`}>Start with Scope <span aria-hidden="true">&rarr;</span></a>
			<a class="scope-btn scope-btn--secondary" href="#see-it-work"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 7 5-7 5Z" fill="currentColor" /></svg> Explore a mock benchmark</a>
		</div>
		<p class="scope-hero-note">Your tasks. Your criteria. Repeatable experiments.</p>
		<scope-showreel>
			<figure class="scope-showreel-frame" style={showreelPosters}>
				<video
					id="scope-showreel-video"
					data-src-dark={`${base}scope-showreel-dark.mp4`}
					data-src-light={`${base}scope-showreel-light.mp4`}
					width="1920"
					height="1080"
					autoplay
					muted
					loop
					playsinline
					preload="none"
					disablepictureinpicture
					aria-describedby="scope-showreel-description"
				></video>
				<figcaption class="sr-only" id="scope-showreel-description">
					Silent Scope showreel: a task prompt, a criteria graph, ordered gates,
					repeated runs, an agent trajectory, and a before-and-after comparison.
				</figcaption>
				<div class="scope-showreel-controls">
					<span role="status" hidden></span>
					<button type="button" aria-controls="scope-showreel-video" hidden disabled>Play showreel</button>
				</div>
			</figure>
		</scope-showreel>
		<div class="scope-agent-strip" aria-label="Documented coding agents">
			<span>Built to evaluate</span>
			<strong>GitHub Copilot</strong>
			<span class="scope-strip-divider" aria-hidden="true"></span>
			<strong>Claude Code</strong>
			<a href={`${base}guides/choosing-a-coding-agent/`}>Meet the agents <span aria-hidden="true">&rarr;</span></a>
		</div>
	</section>

	<section class="scope-section scope-demo-section" id="see-it-work" aria-labelledby="demo-heading">
		<div class="scope-section-heading">
			<div><p class="scope-eyebrow">From a prompt to a picture</p><h2 id="demo-heading">One task. Follow every step.</h2></div>
		</div>
		<FlowDemo />
	</section>

	<section class="scope-section" aria-labelledby="evidence-heading">
		<div class="scope-section-heading">
			<div><p class="scope-eyebrow">Beyond a pass or fail</p><h2 id="evidence-heading">Find the why behind the result.</h2></div>
			<p>A score is a starting point. Understand the task, the setup, and the path an agent took.</p>
		</div>
		<div class="scope-evidence-grid">
			<a class="scope-evidence scope-evidence--wide" href={`${base}guides/defining-criteria/`}>
				<div class="scope-mini-dag" aria-hidden="true"><span>Build</span><i></i><span>Test</span><i></i><span>Evaluate</span></div>
				<p class="scope-eyebrow">Define success</p>
				<h3>Your criteria. Not a generic leaderboard.</h3>
				<p>Model what matters as a criteria graph, with dependencies that make the evaluation meaningful for your product.</p>
				<span class="scope-text-link">Build your criteria graph <span aria-hidden="true">&rarr;</span></span>
			</a>
			<a class="scope-evidence" href={`${base}guides/defining-profiles/`}>
				<div class="scope-profile-preview" aria-hidden="true"><span>Agent <b>Configured</b></span><span>Model <b>Selected</b></span><span>Skills &amp; tools <b>Attached</b></span></div>
				<p class="scope-eyebrow">Keep the context</p><h3>A setup you can run again.</h3>
				<p>Save agent configuration in versioned profiles, so the next experiment starts from a known setup.</p>
				<span class="scope-text-link">Explore profiles <span aria-hidden="true">&rarr;</span></span>
			</a>
			<a class="scope-evidence scope-evidence--trace" href={`${base}guides/submitting-requests-portal/`}>
				<div class="scope-trace-preview" aria-hidden="true"><span>01 <b>Task submitted</b></span><span>02 <b>Agent working</b></span><span>03 <b>Evidence captured</b></span></div>
				<p class="scope-eyebrow">Follow the work</p><h3>Don't lose the story.</h3>
				<p>Follow live logs and inspect the run's iterations and criterion feedback to see where things went right or wrong.</p>
				<span class="scope-text-link">Explore the workflow <span aria-hidden="true">&rarr;</span></span>
			</a>
		</div>
	</section>

	<section class="scope-section" aria-labelledby="docs-heading">
		<div class="scope-section-heading">
			<div><p class="scope-eyebrow">Make your next move</p><h2 id="docs-heading">Less searching. More building.</h2></div>
			<a class="scope-text-link" href={`${base}introduction/concepts/`}>Learn the core concepts <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="scope-paths">
			{paths.map((path) => (
				<a class="scope-path" href={`${base}${path.href}`}>
					<div class="scope-path-top"><span>{path.number}</span><span>{path.tag}</span></div>
					<h3>{path.title}</h3><p>{path.description}</p>
					<span class="scope-text-link">{path.label} <span aria-hidden="true">&rarr;</span></span>
				</a>
			))}
		</div>
	</section>

	<CommunityTeaser />
	<ContributeTeaser />

	<section class="scope-section scope-kubernetes" aria-labelledby="kubernetes-heading">
		<div class="scope-kubernetes-copy">
			<p class="scope-eyebrow">Cloud-native foundations</p>
			<h2 id="kubernetes-heading">Built on<br /><span>Kubernetes.</span></h2>
			<p class="scope-kubernetes-description">
				Your experiments deserve serious infrastructure. Scope runs on
				Kubernetes, bringing containerized agent workers, queue-driven
				scaling with KEDA, and GitOps deployments to your benchmarking stack.
			</p>
			<a class="scope-btn scope-kubernetes-link" href={`${base}self-hosting/overview/`}>Host on Kubernetes <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="scope-kubernetes-brand">
			<img src={`${base}kubernetes-stacked-color.svg`} alt="Kubernetes" width="240" height="234" loading="lazy" />
			<span>Open infrastructure. Repeatable experiments.</span>
		</div>
		<ul class="scope-kubernetes-features">
			<li>
				<div class="scope-feature-graphic">
					<a class="scope-keda-brand" href="https://keda.sh/" target="_blank" rel="noopener noreferrer">
						<img src={`${base}keda-horizontal-color.svg`} alt="KEDA" width="96" height="41" loading="lazy" />
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</div>
				<strong><a href={`${base}self-hosting/scaling/`}>Queue-driven scaling</a></strong>
				<span>KEDA scales workers with demand.</span>
			</li>
			<li>
				<div class="scope-feature-graphic">
					<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m12 3 9 5v8l-9 5-9-5V8l9-5Z" />
						<path d="m3 8 9 5 9-5M12 13v8M7.5 5.5l9 5" />
					</svg>
				</div>
				<strong>Containerized workers</strong>
				<span>Coding agents run in containers.</span>
			</li>
			<li>
				<div class="scope-feature-graphic">
					<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 7v10M18 9v2a8 8 0 0 1-8 8H8" />
						<circle cx="6" cy="5" r="2" />
						<circle cx="6" cy="19" r="2" />
						<circle cx="18" cy="7" r="2" />
					</svg>
				</div>
				<strong>GitOps deployments</strong>
				<span>Flux keeps deployments in sync.</span>
			</li>
		</ul>
	</section>

	<section class="scope-cta" aria-labelledby="cta-heading">
		<p class="scope-eyebrow">Bring your own question</p>
		<h2 id="cta-heading">What will your next<br />benchmark reveal?</h2>
		<p>Start with one task you care about. Scope helps you see the rest.</p>
		<a class="scope-btn scope-btn--primary" href={`${base}getting-started/access/`}>Get started <span aria-hidden="true">&rarr;</span></a>
	</section>
</div>

<script>
	import '../scripts/showreel';
</script>
