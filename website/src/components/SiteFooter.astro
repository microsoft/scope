---
// Copyright (c) Microsoft Corporation.
// Licensed under the MIT License.

import { Icon } from '@astrojs/starlight/components';

interface FooterLink {
	label: string;
	/** Site-root path (e.g. `faq/`) or an absolute external URL. */
	href: string;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/microsoft/scope';
const year = new Date().getFullYear();

const groups: { title: string; links: FooterLink[] }[] = [
	{
		title: 'Get started',
		links: [
			{ label: 'Access', href: 'getting-started/access/' },
			{ label: 'Install the CLI', href: 'getting-started/install-cli/' },
			{ label: 'Your first run', href: 'getting-started/first-run/' },
		],
	},
	{
		title: 'Learn',
		links: [
			{ label: 'What is Scope?', href: 'introduction/what-is-scope/' },
			{ label: 'Concepts', href: 'introduction/concepts/' },
			{ label: 'Choose a coding agent', href: 'guides/choosing-a-coding-agent/' },
			{ label: 'REST API', href: 'reference/rest-api/' },
		],
	},
	{
		title: 'Resources',
		links: [
			{ label: 'FAQ', href: 'resources/faq/' },
			{ label: 'Troubleshooting', href: 'resources/troubleshooting/' },
			{ label: 'Glossary', href: 'resources/glossary/' },
			{ label: 'Data & privacy', href: 'resources/data-collection/' },
		],
	},
	{
		title: 'Community',
		links: [
			{ label: 'Articles & talks', href: 'community/articles-and-talks/' },
			{ label: 'GitHub', href: repo },
			{ label: 'Contributing', href: `${repo}/blob/main/CONTRIBUTING.md` },
			{ label: 'Report an issue', href: `${repo}/issues` },
		],
	},
];

const legal: FooterLink[] = [
	{ label: 'MIT License', href: `${repo}/blob/main/LICENSE` },
	{ label: 'Privacy & Cookies', href: 'https://go.microsoft.com/fwlink/?LinkId=521839' },
	{ label: 'Your Privacy Choices', href: 'https://aka.ms/yourcaliforniaprivacychoices' },
	{ label: 'Consumer Health Privacy', href: 'https://go.microsoft.com/fwlink/?linkid=2259814' },
	{ label: 'Terms of Use', href: 'https://go.microsoft.com/fwlink/?LinkID=206977' },
	{ label: 'Trademarks', href: 'https://www.microsoft.com/trademarks' },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolve = (href: string) => (isExternal(href) ? href : `${base}${href}`);
---

<footer class="scope-footer print:hidden">
	<div class="scope-footer__top">
		<div class="scope-footer__brand">
			<a class="scope-footer__logo" href={base}>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
				</svg>
				<span translate="no">Scope</span>
			</a>
			<p>A clearer view of agentic coding.</p>
		</div>
		<nav class="scope-footer__nav" aria-label="Footer">
			{
				groups.map((group, index) => (
					<div class="scope-footer__group">
						<p class="scope-footer__heading" id={`scope-footer-group-${index}`}>
							{group.title}
						</p>
						<ul aria-labelledby={`scope-footer-group-${index}`}>
							{group.links.map((link) => (
								<li>
									{isExternal(link.href) ? (
										<a href={link.href} target="_blank" rel="noopener noreferrer">
											{link.label}
											<Icon name="external" class="scope-footer__external" />
											<span class="sr-only"> (opens in a new tab)</span>
										</a>
									) : (
										<a href={resolve(link.href)}>{link.label}</a>
									)}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>
	<div class="scope-footer__legal">
		<p>&copy; {year} Microsoft</p>
		<ul aria-label="Legal">
			{
				legal.map((link) => (
					<li>
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label === 'Your Privacy Choices' && (
								<svg class="scope-footer__privacy-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 14" width="30" height="14" aria-hidden="true" focusable="false">
									<rect x="0.6" y="0.6" width="28.8" height="12.8" rx="6.4" fill="#fff" stroke="#06f" stroke-width="1.2" />
									<path d="M17 1.2h5.6a5.8 5.8 0 0 1 0 11.6h-8.7Z" fill="#06f" />
									<path d="m5.5 7 2.7 2.4 4.5-5.3" fill="none" stroke="#06f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									<path d="m19.5 4.5 5 5m0-5-5 5" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
								</svg>
							)}
							{link.label}
							<span class="sr-only"> (opens in a new tab)</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.scope-footer {
		container-type: inline-size;
		margin-top: 1.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--scope-border);
		color: var(--scope-muted);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.scope-footer :is(p, ul) {
		margin: 0;
	}
	.scope-footer ul {
		list-style: none;
		padding: 0;
	}
	.scope-footer a {
		color: inherit;
		text-decoration: none;
	}
	.scope-footer a:hover {
		color: var(--scope-brand);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.scope-footer__top {
		display: grid;
		gap: 2.25rem;
	}
	.scope-footer__brand {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.scope-footer__brand .scope-footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		color: var(--scope-brand);
		font-size: var(--sl-text-lg);
		font-weight: 600;
	}
	.scope-footer__logo svg {
		width: 1.4rem;
		height: 1.4rem;
	}

	.scope-footer__nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}
	.scope-footer__heading {
		margin-bottom: 0.75rem;
		color: var(--scope-text);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.scope-footer__group ul {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.scope-footer__group a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding-block: 0.2rem;
	}
	.scope-footer__group a:hover {
		text-decoration: none;
	}
	.scope-footer__external {
		flex: none;
		font-size: 0.8em;
		opacity: 0.7;
	}

	.scope-footer__legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--scope-border);
		font-size: var(--sl-text-xs);
	}
	.scope-footer__legal ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.25rem;
	}
	.scope-footer__legal a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 24px;
	}
	.scope-footer__privacy-icon {
		flex: none;
	}

	@container (min-width: 34rem) {
		.scope-footer__nav {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	@container (min-width: 60rem) {
		.scope-footer__top {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, 2.5fr);
			gap: 4rem;
		}
	}
</style>
